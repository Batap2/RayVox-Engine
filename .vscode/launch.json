{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GameExemple_Editor (relwithdebinfo)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/relwithdebinfo/bin/GameExemple_Editor.exe",
      "args": ["--project", "${workspaceFolder}/GameExemple"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (msvc-relwithdebinfo)"
    },
    {
      "name": "GameExemple_Editor (debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/GameExemple_Editor.exe",
      "args": ["--project", "${workspaceFolder}/GameExemple"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (msvc-debug)"
    },
    {
      "name": "GameExemple (relwithdebinfo)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/relwithdebinfo/bin/GameExemple.exe",
      "args": ["--project", "${workspaceFolder}/GameExemple"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build (msvc-relwithdebinfo)"
    },
    {
      "name": "GameExemple (debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/GameExemple.exe",
      "args": ["--project", "${workspaceFolder}/GameExemple"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build (msvc-debug)"
    },
    {
      "name": "Batap_Editor bare (relwithdebinfo)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/relwithdebinfo/bin/Batap_Editor.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (msvc-relwithdebinfo)"
    },
    {
      "name": "GameExemple (macos-debug)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/macos-debug/bin/GameExemple",
      "args": ["--project", "${workspaceFolder}/GameExemple"],
      "cwd": "${workspaceFolder}",
      "env": {
        "DYLD_LIBRARY_PATH": "/opt/homebrew/lib"
      },
      "preLaunchTask": "Build (macos-debug)"
    },
    {
      "name": "GameExemple_Editor (macos-debug)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/macos-debug/bin/GameExemple_Editor",
      "args": ["--project", "${workspaceFolder}/GameExemple"],
      "cwd": "${workspaceFolder}",
      "env": {
        "DYLD_LIBRARY_PATH": "/opt/homebrew/lib"
      },
      "preLaunchTask": "Build (macos-debug)"
    }
  ]
}
